---
layout: layout.liquid
title: Home
---

<section class="hero">
  <h1>Personal logs from a lone human beyond the charts.</h1>
  <p class="lead">
    I left Earth with a ship that hums like a patient animal and a map that ends too early.
    Everything after that is guesswork, gravity, and the stubborn comfort of routine.
  </p>

  {% signal "Transmission" , "If you find this archive, know that the silence is not empty. It is simply wide." %}
</section>

<section class="grid">
  <h2 class="section-title">Latest entries</h2>

  <div class="cards">
    {% for post in collections.logs %}
      <article class="card">
        <h3 class="card__title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
        <p class="meta">{{ post.date | date: "%b %d, %Y" }} · {{ post.data.location }}</p>
        <p class="card__excerpt">{{ post.data.excerpt }}</p>
        <a class="card__link" href="{{ post.url }}">Read full log →</a>
      </article>
    {% endfor %}
  </div>
</section>
